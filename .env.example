# El Observatorio — Supabase environment template.
# Copy to .env.local (Vite reads it automatically; gitignored):
#   cp .env.example .env.local
#
# !!! SECURITY WARNING — READ THIS !!!
# The ANON key is public by design: it ships to the browser and can be read by
# anyone opening devtools. That is fine ONLY because row-level security (RLS)
# protects every table. NEVER put SUPABASE_SERVICE_ROLE_KEY (or any secret)
# here or anywhere in the client bundle — the CI workflow rejects any
# service_role reference outside this file.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key